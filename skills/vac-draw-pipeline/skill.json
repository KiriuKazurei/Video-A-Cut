{
  "id": "vac-draw-pipeline",
  "name": "绘制管线",
  "description": "Project-scoped controlled drawing tools, live frame preview and editable source import. No arbitrary shell.",
  "version": "0.3.0",
  "source": "builtin",
  "runtime": "harness",
  "compatible_flows": [
    "custom"
  ],
  "execution_modes": [
    "external_mcp",
    "builtin_api"
  ],
  "tools": [
    "draw.list",
    "draw.save",
    "draw.check",
    "draw.render",
    "draw.get_frame",
    "draw.import",
    "draw.capabilities",
    "draw.preview",
    "timeline.read",
    "timeline.edit",
    "references.resolve",
    "artifacts.list",
    "artifacts.get",
    "run.finish"
  ],
  "permissions": [
    "project_media",
    "ffmpeg",
    "browser_render"
  ],
  "inputs": [
    "goal",
    "composition_spec",
    "project_images"
  ],
  "outputs": [
    "composition_source"
  ],
  "flows": [
    "lightweight",
    "visual_heavy",
    "custom"
  ]
}
