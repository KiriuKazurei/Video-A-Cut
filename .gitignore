# Build artifacts
/build/
# All local runtime state, test evidence, caches, credentials and media
/.run-data/
*.exe
*.test
*.out

# SQLite databases (local state, never committed)
*.db
*.db-wal
*.db-shm

# Frontend
node_modules/
dist/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.tsbuildinfo
coverage/

# Env & secrets
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Hermes local scratch
.hermes/

# Design documents: finalized upstream (企业微信/共享盘), not versioned here.
# Committing them would fork two copies that drift apart, and this repo is
# where the executable truth of those requirements lives in code.
IDEA.md
docs/
