/.run-data/
/test-support/legacy/
*.exe
*.test
*.out

# SQLite databases (local state, never committed)
*.db
*.db-wal
*.db-shm

# Frontend
node_modules/
dist/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
