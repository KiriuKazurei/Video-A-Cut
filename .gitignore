coverage/

# Env & secrets
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Hermes local scratch
.hermes/

# Development documents stay local, except the frontend API handoff,
# the flow-optimize stage plan, progress, handoff, and the hard UI style spec.
/desktop/desktop.local.json
/docs/*
!/docs/前端接口清单与重构交接.md
!/docs/frontend-api-inventory.json
!/docs/flow-optimize-stages.md
!/docs/flow-optimize-progress.md
!/docs/flow-optimize-handoff.md
