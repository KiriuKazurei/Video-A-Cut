{
  "name": "@video-auto-cut/webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint:style": "node scripts/lint-style.mjs",
    "test:unit": "node --experimental-strip-types --test test_suite.mjs desktop_test.mjs tts_test.mjs && node --experimental-strip-types --test pipeline_test.mjs evidence_summary_test.mjs tour_test.mjs auto_run_test.mjs visible_set_test.mjs script_workbench_test.mjs style_lint_test.mjs style_smoke_test.mjs && node scripts/lint-style.mjs",
    "test:pipeline": "node --experimental-strip-types --test pipeline_test.mjs",
    "test:managed": "pwsh -NoProfile -File ../scripts/TestWorkspace.ps1 -Action Run -Suite webui",
    "test:browser-tts": "echo 'Run: python3 /workspace/vac-demo/run_browser_tests.py tts' && python3 /workspace/vac-demo/run_browser_tests.py tts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@tanstack/react-query": "^5.0.0",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
